# Copie ce fichier en .env et remplis-le.  cp .env.example .env
# .env est gitignoré.

# Clé secrète Scaleway — Console > IAM > Clés API
# Le projet doit avoir accès aux Generative APIs.
SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Identifiant du modèle tel que servi par Scaleway.
# Confirme-le avec `make models` avant de compter dessus.
MODEL=glm-5.2

# Clé arbitraire protégeant le proxy local. Devient ton ANTHROPIC_AUTH_TOKEN.
PROXY_KEY=sk-local-dev-1234

# Port d'écoute de LiteLLM
PROXY_PORT=4000
